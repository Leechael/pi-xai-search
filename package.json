{
  "name": "pi-xai-search",
  "version": "0.1.0",
  "description": "Pi extension for xAI web_search and x_search — reuse your xAI/Grok subscription in pi-coding-agent",
  "keywords": [
    "coding-agent",
    "grok",
    "oauth",
    "pi",
    "pi-coding-agent",
    "pi-extension",
    "pi-package",
    "responses-api",
    "tool-extension",
    "tweet-search",
    "tweet_search",
    "web-search",
    "web_search",
    "x-search",
    "x_search",
    "xai",
    "xai-search"
  ],
  "bugs": {
    "url": "https://github.com/Leechael/pi-xai-search/issues"
  },
  "license": "MIT",
  "author": "Leechael",
  "repository": {
    "type": "git",
    "url": "https://github.com/Leechael/pi-xai-search"
  },
  "files": [
    "index.ts",
    "src",
    "package.json",
    "README.md",
    "LICENSE"
  ],
  "type": "module",
  "scripts": {
    "clean": "echo 'nothing to clean'",
    "build": "echo 'nothing to build'",
    "check": "tsc --noEmit",
    "test": "node --test --experimental-strip-types tests/*.test.ts",
    "lint": "oxlint .",
    "format": "oxfmt . --write",
    "format:check": "oxfmt . --check",
    "pre-commit": "prek run"
  },
  "dependencies": {
    "typebox": "^1.1.38"
  },
  "devDependencies": {
    "@earendil-works/pi-ai": "^0.82.0",
    "@earendil-works/pi-coding-agent": "^0.82.0",
    "@j178/prek": "^0.4.4",
    "@types/node": "^24.0.0",
    "oxfmt": "^0.44.0",
    "oxlint": "^1.59.0",
    "typescript": "^5.9.0"
  },
  "peerDependencies": {
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-coding-agent": "*"
  },
  "engines": {
    "node": ">=22"
  },
  "pi": {
    "extensions": [
      "./index.ts"
    ]
  }
}
